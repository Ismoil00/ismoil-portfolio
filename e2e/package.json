{
  "name": "portfolio-e2e",
  "private": true,
  "description": "End-to-end tests: a real browser (Microsoft Edge) on the public site and the admin panel, against the real backend.",
  "type": "module",
  "scripts": {
    "test": "node scripts/run.mjs",
    "test:ui": "node scripts/run.mjs --ui",
    "test:headed": "node scripts/run.mjs --headed",
    "report": "node scripts/run.mjs show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
