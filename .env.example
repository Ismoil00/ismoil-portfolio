# For docker compose only (docker-compose.yml): copy to .env in this folder and fill in.
# These are for the containers on your machine — never reuse them in production.

# Password of the containers' own PostgreSQL (any long random string).
POSTGRES_PASSWORD=
# Long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Shared by the backend and the public site (the contact form's per-visitor limit). Another random string.
INTERNAL_API_TOKEN=
