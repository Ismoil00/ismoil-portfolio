# Store and check out text files with LF line endings on every machine (Windows editors handle LF).
* text=auto eol=lf

# Never touch binary files.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary
*.mov binary
