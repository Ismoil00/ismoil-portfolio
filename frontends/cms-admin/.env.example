# Copy to .env.local.
# Backend base URL (server-side calls and the /api, /media forwarding).
API_URL=http://localhost:8000
# The public site, for the "View site" link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production only (Vercel Blob): big files go from the browser straight to Blob, since a request to
# Vercel can't exceed 4.5 MB. BLOB_READ_WRITE_TOKEN is added when the Blob store is connected to the project.
# NEXT_PUBLIC_DIRECT_UPLOADS=true
# BLOB_READ_WRITE_TOKEN=
