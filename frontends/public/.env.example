# Copy to .env.local and fill in.

# Public URL of the deployed site (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The backend's API, called from the server only (pages and the contact form's Server Action),
# so its address never reaches the browser.
API_URL=http://localhost:8000/api/v1

# Production only: shared with the backend (its INTERNAL_API_TOKEN), so the contact form's per-visitor
# limit sees each visitor's IP on Vercel. Leave unset locally.
# INTERNAL_API_TOKEN=
