{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "public",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontends/public"
      ],
      "port": 3000
    },
    {
      "name": "public-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--prefix",
        "frontends/public",
        "--",
        "-p",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontends/cms-admin"
      ],
      "port": 3001
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/uvicorn.exe",
      "runtimeArgs": [
        "app.main:create_app",
        "--factory",
        "--reload",
        "--reload-dir",
        "backend/app",
        "--port",
        "8000",
        "--app-dir",
        "backend"
      ],
      "port": 8000
    }
  ]
}
