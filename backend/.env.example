# Copy to .env and fill in. Values here are the defaults unless marked "required".

# development | production | test
ENV=development

# PostgreSQL (asyncpg). TEST_DB_NAME is wiped and re-created by the test suite. DB_PASSWORD is required.
DB_HOST=localhost
DB_PORT=5432
DB_USER=portfolio
DB_PASSWORD=
DB_NAME=portfolio
TEST_DB_NAME=portfolio_test
# Production (Neon): set by the Vercel–Neon integration instead of the DB_* lines. The app uses the
# pooled DATABASE_URL; migrations and scripts use DATABASE_URL_UNPOOLED. Tests always use the DB_* lines.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Required. Long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Cookies: true in production (https). Names get the __Host- prefix automatically when true.
COOKIE_SECURE=true
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# Browser origins allowed to call the API directly (JSON list).
CORS_ORIGINS=[]
# Origins allowed to send admin writes (checked against the Origin header).
ADMIN_ORIGINS=["http://localhost:3001"]
# Proxies whose X-Forwarded-For header is trusted (the Next.js servers).
TRUSTED_PROXIES=["127.0.0.1","::1"]
# Production only. On Vercel the visitor's IP is read from x-real-ip automatically. The public site's
# server names each visitor with this shared token (same value in the public site's INTERNAL_API_TOKEN).
# INTERNAL_API_TOKEN=
# Vercel Cron calls the daily cleanup with this secret (Authorization: Bearer …); without it the route is off.
# CRON_SECRET=

# Abuse limits
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
CONTACT_MAX_PER_HOUR=5

# File storage: local (development, files in backend/storage), s3 (MinIO, RustFS, R2, AWS…) or blob (Vercel Blob)
STORAGE_BACKEND=local
# local: the backend's /media · s3: the bucket's public URL · blob: leave as is (worked out from the Blob token)
MEDIA_BASE_URL=http://localhost:8000/media
# blob only: the store's read-write token (on Vercel it's added when the store is connected to the project).
# BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT_URL=
S3_BUCKET=portfolio
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Translate button in the admin panel (optional; without it the RU/TG tabs are filled by hand).
ANTHROPIC_API_KEY=

# AI assistant on the public site (optional; Groq's free tier, from console.groq.com → API Keys).
# Without it the assistant is off. With it, switch the assistant on in the admin panel's Settings.
GROQ_API_KEY=
# Its limits (the defaults are shown). Per visitor, counted per chat cookie and per IP:
# CHAT_MAX_PER_10_MINUTES=6
# CHAT_MAX_PER_DAY=20
# CHAT_MAX_PER_NETWORK_PER_DAY=40
# Our share of each Groq model's free quota (kept a little below Groq's own limits):
# CHAT_MODEL_TOKENS_PER_DAY=180000
# CHAT_MODEL_REQUESTS_PER_DAY=900
# CHAT_MODEL_TOKENS_PER_MINUTE=7000
